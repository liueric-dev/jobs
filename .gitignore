# Python
__pycache__/
*.pyc
.venv/
venv/

# Build artefacts from an editable install
*.egg-info/
build/
dist/
node_modules/

# Secrets and machine-local environment files.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
# Keep legacy local credentials and state ignored after the code removal.
backend/api/contributor-worker/config.json
backend/api/contributor-worker/worker-state.json
credentials.json

# cloudflared. `cloudflared tunnel create` writes ~/.cloudflared/<UUID>.json,
# which is a BEARER CREDENTIAL for the tunnel -- anyone holding it can run the
# tunnel and receive traffic for its hostnames. cert.pem from `cloudflared
# login` is already covered by *.pem above. Neither belongs in deploy/, and
# deploy/cloudflared/config.yml points at their real home outside the repo;
# these two lines exist so that copying one in "just to test" cannot commit it.
deploy/**/*.json
.cloudflared/

# Local database artefacts
*.sql
*.sql.gz
*.dump
backup*.tar.gz

# Logs and scratch
*.log
tmp/

# Legacy local caches may contain private or metered response data.
evals/.cache/
backend/evals/.cache/
serp/.cache/
backend/serp/.cache/

# Local assistant configuration.
.claude/
.codex/

# Machine-specific scripts outside the application tree.
/scripts/

# flock target from the systemd unit ExecStart -- created on every run
.run.lock

# Per-run volume history, appended by run-daily.py and read by
# tools/volume-check.py. Machine-local operational state, not code: it describes
# what THIS host ingested, so committing it would mean one machine's quiet
# Tuesday becoming another machine's floor. See config/volume-floors.json.
.run-volumes.jsonl

# Dev-only virtualenv for lint and type checks.
.venv-dev/
