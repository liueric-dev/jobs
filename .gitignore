# Python
__pycache__/
*.pyc
.venv/
venv/

# Build artefacts from an editable install
*.egg-info/
build/
dist/

# Secrets. Since slice D these live IN this tree, not in ~/.hermes/.env: ./.env
# for the pipeline and api/.env for the service, which holds a deliberately
# different, restricted credential. Both are mode 600 with a tracked
# .env.example beside them. This repository is cloned to several machines and
# hosted remotely: a credential committed here is a credential on all of them,
# and in the host's history permanently.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# Local database artefacts
*.sql
*.sql.gz
*.dump
backup*.tar.gz

# Logs and scratch
*.log
tmp/

# Cached model responses (backend/evals). Large, worthless to anyone else, and
# they hold the full text of postings -- not something to put in git history by
# accident. evals/cache.py also drops a .gitignore in the directory itself, so
# a relocated EVAL_CACHE_DIR stays covered too.
evals/.cache/
backend/evals/.cache/

# Agent worktrees and scratch state. CLAUDE.md is the deliberate exception: it
# is the project brief every session reads before doing anything, and while it
# was ignored it was machine-local -- so a correction to it could be made and
# could not be committed, which is how tasks 38 and 40 found themselves editing
# a file no diff could carry. settings.local.json stays ignored; it is this
# machine's permission state and means nothing on another.
.claude/*
!.claude/CLAUDE.md

# Agent-orchestration harness, not project code. 183b4dc untracked
# scripts/tranche-two-launcher.sh on purpose -- it hard-codes this machine,
# drives tmux, and runs tranche_two tasks that are all done -- and 3383f9a said
# it would. It was NOT deleted: it is the owner's file and the owner's call
# whether it moves to ~/bin/. But untracked-and-unignored means it shows as ??
# in every git status and it has already been re-added once by a git add -A,
# which is the exact thing 183b4dc exists to undo. Ignoring it makes the
# decision durable instead of dependent on nobody typing -A.
scripts/

# flock target from the systemd unit ExecStart -- created on every run
.run.lock
