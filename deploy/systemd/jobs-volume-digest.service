[Unit]
Description=Send the weekly per-source volume digest
Documentation=file:///home/eric/apps/jobs/docs/STATE-OF-THE-SYSTEM.md
# The third of the three monitoring requirements, and the one that is a REPORT
# rather than an alarm: surface per-source counts somewhere a human sees them
# weekly WITHOUT GOING LOOKING.
#
# Why it is not enough to rely on jobs-volume-check: that unit is silent when
# everything is within its floors, and silence is indistinguishable from a
# broken checker. This arrives every week whether or not anything fired, so a
# week with no digest is itself the signal -- which is the same argument
# run-daily.py makes for printing its volume line on clean runs.
#
# It also carries the `skipped (insufficient history)` rows, which is where a
# newly-added source that nobody has floored yet becomes visible.
#
# NO OnFailure= here, and that is the point of the `|| true`: a digest is not
# worth an alert. If hermes cannot deliver it, the journal says so and the next
# week's digest tries again. An alert about a failed report is how a channel
# stops being read.

[Service]
Type=oneshot
WorkingDirectory=/home/eric/apps/jobs/backend
Environment=HERMES_HOME=/home/eric/.hermes
# --digest always exits 0; it is a table, not a verdict. `hermes send --to
# telegram` is the same channel jobs-failure@ uses, so there is one place to
# look rather than two.
ExecStart=/bin/sh -c '/usr/bin/python3 /home/eric/apps/jobs/backend/tools/volume-check.py --digest | /home/eric/.local/bin/hermes send --to telegram -f - || true'
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jobs-volume-digest
