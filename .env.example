# Template for ~/apps/jobs/.env. Copy, fill in, chmod 600.
#
#     cp .env.example .env && chmod 600 .env
#
# THE FORMAT IS A CONTRACT, because two different parsers read this file:
# systemd's EnvironmentFile= and pipelib.envfile.load(). They do NOT parse
# identically, so stay inside the intersection:
#
#   * plain KEY=value, one per line
#   * comments on their OWN line only -- never trailing after a value
#   * no `export ` prefix
#   * no $VAR expansion, no command substitution, no multi-line values
#   * no surrounding quotes
#
# The trailing-comment rule is not hypothetical. ~/.hermes/.env line 38 is
#     GEMINI_API_KEY=<value> # alias for GOOGLE_API_KEY
# pipelib.envfile strips that shell-compatibly; systemd does not, and would
# set the comment as part of the key. That single line is why this pipeline
# has its own .env rather than pointing EnvironmentFile= at the harness's.
#
# WHY BOTH READ IT: jobs-ingest.service sets EnvironmentFile=, and run-daily.py
# also calls envfile.load() on the same path. Deliberate belt and braces, so a
# manual run in a bare shell behaves like the scheduled one. envfile.load()
# uses override=False, so the unit's values win when both are present.
#
# api/ has its own .env with a DIFFERENT, restricted credential -- see
# api/.env.example. Do not consolidate them: that separation is slice A's
# least-privilege work, not an oversight.

# --- required: every step connects to Postgres ------------------------------
# run-daily.py refuses to start without this and says so in one line.
DATABASE_URL=postgresql://jobs_pipeline:PASSWORD@localhost:5432/jobs

# --- required by the two Google ingest steps --------------------------------
# Each machine running ingest/google-serpapi.py should use its OWN SerpApi key:
# the free tier is per-account, so a second machine adds quota rather than
# splitting it. Both steps exit non-zero with a named error if unset.
SERPAPI_API_KEY=
APIFY_API_TOKEN=

# --- required by score.py and extract.py ------------------------------------
# score.py falls back to GLM_API_KEY if JOB_SCORING_API_KEY is unset, and
# llm.py resolves the base URL and model through a further chain -- see
# llm.py's docstring before pruning any of these.
JOB_SCORING_API_KEY=
JOB_SCORING_BASE_URL=
JOB_SCORING_MODEL=

# --- optional LLM configuration ---------------------------------------------
# Consumed indirectly through llm.py and ratelimit.py. Present here because the
# fallback chains are layered enough that reasoning them out statically is not
# safe; drop what a verified run proves unnecessary.
GLM_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
LLM_QUOTA_TZ=
LLM_MAX_RPD__gemini_3_6_flash=
LLM_MAX_RPM__gemini_3_6_flash=
