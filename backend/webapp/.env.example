# Copy to .env (mode 600) and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env && chmod 600 .env
#
# THE FORMAT IS A CONTRACT, same as the pipeline's .env one directory up:
#
#   * plain KEY=value, one per line
#   * comments on their OWN line only -- never trailing after a value
#   * no `export ` prefix, no $VAR expansion, no quotes, no multi-line values
#
# config.py reads this file through lib.envfile with override=False, so an
# exported value beats the file. That is what makes a one-off
# `DATABASE_URL=... uvicorn app:app` behave the way you expect.
#
# THERE ARE TWO DATABASE CREDENTIALS ON PURPOSE, exactly as in api/.env.example:
# the service runs on the restricted one, and the admin one is used only by
# `manage_app_users.py init-schema`, the single command that issues DDL. That
# separation is what lets this long-running, browser-facing process hold no
# schema-modification rights at all.

# --- required ---------------------------------------------------------------
# The restricted role. Granted SELECT on the pipeline's read tables, SELECT +
# INSERT on job_events, and full rights on only the three tables this service
# owns. No UPDATE or DELETE on anything the pipeline owns, and no DDL.
# app.py refuses to start if any of those grants is missing, naming which.
# There is deliberately NO default: applications on this Postgres instance are
# told apart only by the database named here, and every one of them uses
# unqualified table names in `public`.
DATABASE_URL=postgresql://jobs_web:CHANGEME@localhost:5432/jobs

# --- required for anyone to log in ------------------------------------------
# From the Google Cloud Console -> Credentials -> OAuth client ID -> Web
# application. See README "Google Cloud Console" -- and note the test-users
# trap: while the consent screen is unverified, an address must be on Google's
# test-user list AND in app_users, and only one of those two failures produces
# an error message from this service.
#
# GOOGLE_REDIRECT_URI must match the console's "Authorized redirect URI"
# BYTE-FOR-BYTE, trailing slash included.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8421/v1/auth/callback

# --- browser-facing ---------------------------------------------------------
# Where the OAuth callback sends the browser once the session cookie is set.
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated CORS allowlist. Explicit origins only -- "*" is incompatible
# with credentialed requests, and the browser silently drops the session cookie
# rather than reporting it. Once the frontend is served from the same origin as
# this service, this can be empty.
ALLOWED_ORIGINS=http://localhost:5173

# --- optional: all have working defaults. See README "Configuration". --------
# SESSION_COOKIE_SECURE defaults to true. Set it false ONLY for local
# plain-HTTP development -- with it false in production the session cookie
# travels in the clear on every request.
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_NAME=jobs_session
# SESSION_TTL_DAYS=30
# OAUTH_STATE_TTL_MINUTES=10
# PORT=8421

# Admin/owner role, for `manage_app_users.py init-schema` only. Leave unset for
# normal operation -- it falls back to DATABASE_URL, which will fail on CREATE
# with a legible "permission denied" rather than doing something surprising.
# JOBS_ADMIN_DATABASE_URL=postgresql://jobs_pipeline:CHANGEME@localhost:5432/jobs
