# Copy to .env (mode 600) and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env && chmod 600 .env
#   set -a; . .env; set +a          # same idiom the pipeline shell scripts use
#
# There are TWO credentials on purpose. The service runs on the restricted one;
# the admin one is used only by `manage_users.py init-schema`, which is the only
# command that issues DDL. Keeping them separate is what lets the long-running,
# untrusted-facing process hold no schema-modification rights.

# Restricted role. Granted SELECT/INSERT/UPDATE on exactly the six tables in
# query_claims.REQUIRED_TABLES -- no DELETE, no DDL, and nothing on the seven
# pipeline-owned tables or the jobs_app view. Events data is not merely
# ungranted but unreachable: since slice E it lives in a separate database that
# this role cannot connect to at all.
# app.py refuses to start if any of those grants is missing.
DATABASE_URL=postgresql://jobs_api:CHANGEME@localhost:5432/jobs

# Admin/owner role, for `manage_users.py init-schema` only. Leave unset for
# normal operation -- it falls back to DATABASE_URL, which will fail on CREATE
# with a legible "permission denied" rather than doing something surprising.
# JOBS_ADMIN_DATABASE_URL=postgresql://jobs_pipeline:CHANGEME@localhost:5432/jobs

# Optional -- all have working defaults. See README "Configuration".
# GOOGLE_QUERIES_FILE=config/google-queries.json
# CLAIM_TTL_MINUTES=15
# GOOGLE_JOBS_MIN_HOURS_BETWEEN_RUNS=20
# MAX_JOBS_PER_SUBMIT=50
# MAX_QUERIES_PER_CLAIM=5
# MAX_CLAIMS_PER_CONTRIBUTOR_PER_DAY=50
# MAX_BODY_BYTES=2097152
