# Copy to .env and chmod 600. Use plain assignments, without quotes,
# export prefixes, interpolation, or trailing comments; both systemd and
# lib/envfile.py read this file.

# Required: use a database dedicated to this project.
DATABASE_URL=postgresql://jobs_pipeline:PASSWORD@localhost:5432/jobs

# Optional: higher request limit for NYC Open Data. Anonymous access works.
SOCRATA_APP_TOKEN=
